# ============================================================================
# VisionTrace Environment Configuration
# ============================================================================

# Node.js Gateway
GATEWAY_PORT=5000
JWT_SECRET=super_secure_jwt_secret_visiontrace_2026
JWT_EXPIRES_IN=8h
UPLOAD_DIR=./uploads
VITE_API_URL=http://localhost:5000/api/v1

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=visiontrace
PG_USER=postgres
PG_PASSWORD=postgrespassword

# FastAPI AI Engine
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://localhost:8000/internal/v1

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=visiontrace

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_TASK_TTL_SECONDS=86400

# AI Models & Sampling
YOLO_MODEL_PATH=yolov8n.pt
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FRAME_SAMPLE_INTERVAL_SECONDS=1.0
YOLO_CONFIDENCE_THRESHOLD=0.35
FAISS_INDEX_STORAGE_PATH=./data/faiss_index.bin
FAISS_METADATA_STORAGE_PATH=./data/faiss_metadata.json
